//===========//
// parameters
//===========//

params {
    reads  = null
    skip_assembly = 'false'
    type_assembly = 'spades'
    contigs = null
    probes = null
    nb_samples = '21'
    gblocks = true
    percent = '0.75'
    outdir = 'results'
    kraken_db = '/bank/kraken/k2_pluspfp_20251015'
    busco_db = 'hymenoptera_odb12'
}

executor {
    name = 'slurm'
    queueSize = 100
}

outputDir = params.outdir

//singularity.enabled = true
//singularity.autoMounts = true

process {
    executor       = 'slurm'
    queue          = 'workq'
    errorStrategy  = 'retry'
    maxRetries     = 2

    withName: 'FASTQC_RUN' {
      memory = 4.GB
      cpus   = 2
      time   = '2h'
    }

    withName: 'MULTIQC_RUN' {
      memory = 4.GB
      cpus   = 1
      time   = '1h'
    }

    withName: 'CONTAMINATION' {
      memory = 300.GB
      cpus   = 8
      time   = '5h'
    }

        withName: 'REMOVE' {
      memory = 24.GB
      cpus   = 1
      time   = '16h'
    }

        withName: 'CHECK' {
      memory = 300.GB
      cpus   = 8
      time   = '5h'
    }

        withName: 'CONTAM_SUMMARY' {
      memory = 3.GB
      cpus   = 1
      time   = '1h'
    }

        withName: 'FASTQC_RUN_AFTER' {
      memory = 4.GB
      cpus   = 2
      time   = '2h'
    }

    withName: 'MULTIQC_RUN_AFTER' {
      memory = 4.GB
      cpus   = 1
      time   = '1h'
    }

    withName: 'SPADES_ASSEMBLY' {
      memory = 500.GB
      cpus   = 28
      time   = '1d'
      errorStrategy = 'terminate'
    }

    withName: 'MEGAHIT_ASSEMBLY' {
      memory = 60.GB
      cpus   = 28
      time   = '7h'
    }

    withName: 'QUAST' {
      memory = 10.GB
      cpus   = 2
      time   = '1h'
    }

    withName: 'BUSCO_DOWNLOAD' {
      cpus   = 2
      memory = 24.GB
      time   = '1h'
    }

    withName: 'BUSCO' {
      memory = 32.GB
      cpus   = 2
      time   = '4h'
    }
}



//debug//
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true 
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true  
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,name,status,exit,duration,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,memory,cpus'
    overwrite = true
}
