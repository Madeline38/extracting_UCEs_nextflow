//===========//
// parameters
//===========//

params {
    reads  = null
    skip_decontamination = false
    kraken_db = '/bank/kraken/k2_pluspfp_20251015'
    keep_kraken_output = false
    skip_assembly = false
    contigs = null
    type_assembly = 'megahit'
    busco_db = 'hymenoptera_odb12'
    probes = null
    flank = null
    min_percent = 0
    trimming = 'none'
    mode_clipkit = 'kpic'
    phylogenetic_format = 'phylip'
    outdir = 'results'
}

executor {
    name = 'slurm'
    queueSize = 100
}

outputDir = params.outdir

singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = '--bind /bank:/bank'

process {
    executor       = 'slurm'
    queue          = 'workq'
    beforeScript   = 'module load containers/Apptainer/1.4.1'
    errorStrategy  = 'retry'
    maxRetries     = 2

    withName: 'FASTQC' {
      memory = 2.GB
      cpus   = 2
      time   = '30m'
    }

    withName: 'MULTIQC' {
      memory = 2.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'CHECK' {
      memory = 260.GB
      cpus   = 8
      time   = '30m'
    }

        withName: 'REMOVE' {
      memory = 24.GB
      cpus   = 1
      time   = '10h'
    }

        withName: 'SUMMARY_DECONTAMINATION' {
      memory = 2.GB
      cpus   = 1
      time   = '30m'
      errorStrategy = 'ignore'
    }

        withName: 'FASTQC_AFTER' {
      memory = 2.GB
      cpus   = 2
      time   = '30m'
    }

    withName: 'MULTIQC_AFTER' {
      memory = 2.GB
      cpus   = 1
      time   = '10m'
    }

    withName: 'ASSEMBLY_SPADES' {
      memory = 500.GB
      cpus   = 28
      time   = '1d'
      errorStrategy = 'terminate'
    }

    withName: 'ASSEMBLY_MEGAHIT' {
      memory = 40.GB
      cpus   = 28
      time   = '5h'
    }

    withName: 'QUAST' {
      memory = 2.GB
      cpus   = 1
      time   = '10m'
      errorStrategy = 'ignore'
    }

    withName: 'BUSCO_DOWNLOAD' {
      cpus   = 1
      memory = 2.GB
      time   = '5m'
      errorStrategy = 'ignore'
    }

    withName: 'BUSCO' {
      memory = 10.GB
      cpus   = 2
      time   = '2h'
      errorStrategy = 'ignore'
    }

    withName: 'ALIGNMENT_LASTZ' {
      memory = 1.GB
      cpus   = 1
      time   = '30m'
    }

    withName: 'REMOVE_PARALOGS' {
      memory = 1.GB
      cpus   = 1
      time   = '10m'
    }

    withName: 'SUMMARY_REMOVE_PARALOGS' {
      memory = 1.GB
      cpus   = 1
      time   = '10m'
      errorStrategy = 'ignore'
    }

    withName: 'EXTRACT_FLANKED' {
      memory = 1.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'COMBINE_BY_LOCUS' {
      memory = 1.GB
      cpus   = 1
      time   = '10m'
    }

    withName: 'MSA_MAFFT' {
      memory        = 1.GB
      cpus          = 1
      time          = '30m'
    }

    withName: 'SUMMARY_MSA' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
      errorStrategy = 'ignore'
    }

    withName: 'TRIMAL' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
    }

    withName: 'BMGE' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
    }

    withName: 'CLIPKIT' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
    }

    withName: 'STATS_MSA' {
      memory        = 5.GB
      cpus          = 1
      time          = '30m'
    }

    withName: 'PLOT_MSA_STATS' {
      memory        = 5.GB
      cpus          = 1
      time          = '1h'
    }
  
    withName: 'FILTER_MSA' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
    }

    withName: 'CONCATENATE_MSA' {
      memory        = 1.GB
      cpus          = 1
      time          = '30m'
    }

}



//debug//
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true 
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true  
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,name,status,exit,duration,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,memory,cpus'
    overwrite = true
}
