//===========//
// parameters
//===========//

params {
    reads  = null
    skip_decontamination = false
    kraken_db = '/bank/kraken/k2_pluspfp_20251015'
    keep_kraken_output = false
    skip_assembly = false
    contigs = null
    type_assembly = 'megahit'
    busco_db = 'hymenoptera_odb12'
    probes = null
    flank = 160
    min_percent = 75
    trimming = 'none'
    phylogenetic_format = 'nexus'
    outdir = 'results'
}

executor {
    name = 'slurm'
    queueSize = 100
}

outputDir = params.outdir

singularity.enabled = true
singularity.autoMounts = true
singularity.runOptions = '--bind /bank:/bank'

process {
    executor       = 'slurm'
    queue          = 'workq'
    beforeScript   = 'module load containers/Apptainer/1.4.1'
    errorStrategy  = 'retry'
    maxRetries     = 2

    withName: 'FASTQC_RUN' {
      memory = 2.GB
      cpus   = 2
      time   = '30m'
    }

    withName: 'MULTIQC_RUN' {
      memory = 2.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'CONTAMINATION' {
      memory = 260.GB
      cpus   = 8
      time   = '30m'
    }

        withName: 'REMOVE' {
      memory = 24.GB
      cpus   = 1
      time   = '10h'
    }

        withName: 'CHECK' {
      memory = 300.GB
      cpus   = 8
      time   = '30m'
    }

        withName: 'CONTAM_SUMMARY' {
      memory = 1.GB
      cpus   = 1
      time   = '1m'
    }

        withName: 'FASTQC_RUN_AFTER' {
      memory = 2.GB
      cpus   = 2
      time   = '30m'
    }

    withName: 'MULTIQC_RUN_AFTER' {
      memory = 2.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'SPADES_ASSEMBLY' {
      memory = 500.GB
      cpus   = 28
      time   = '1d'
      errorStrategy = 'terminate'
    }

    withName: 'MEGAHIT_ASSEMBLY' {
      memory = 40.GB
      cpus   = 28
      time   = '5h'
    }

    withName: 'QUAST' {
      memory = 2.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'BUSCO_DOWNLOAD' {
      cpus   = 1
      memory = 2.GB
      time   = '5m'
    }

    withName: 'BUSCO' {
      memory = 10.GB
      cpus   = 2
      time   = '2h'
    }

    withName: 'ALIGNMENT_LASTZ' {
      memory = 1.GB
      cpus   = 1
      time   = '30m'
    }

    withName: 'REMOVE_PARALOGS' {
      memory = 1.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'SUMMARY_REMOVE_PARALOGS' {
      memory = 1.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'EXTRACT_FLANKED' {
      memory = 1.GB
      cpus   = 1
      time   = '5m'
    }

    withName: 'COMBINE_BY_LOCUS' {
      memory = 1.GB
      cpus   = 1
      time   = '10m'
    }

    withName: 'MAFFT' {
      memory        = 1.GB
      cpus          = 1
      time          = '30m'
    }

    withName: 'NEXUS_FORMAT' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
    }

    withName: 'PHYLIP_FORMAT' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
    }

    withName: 'TRIMAL' {
      memory        = 1.GB
      cpus          = 1
      time          = '5m'
    }

    withName: 'UCES_ANALYSIS' {
      memory        = 1.GB
      cpus          = 1
      time          = '10m'
    }
}



//debug//
report {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/report.html"
    overwrite = true 
}
timeline {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/timeline.html"
    overwrite = true  
}
trace {
    enabled   = true
    file      = "${params.outdir}/pipeline_info/trace.txt"
    fields    = 'task_id,hash,name,status,exit,duration,realtime,%cpu,rss,peak_rss,vmem,peak_vmem,memory,cpus'
    overwrite = true
}
